        {
          "in": [
            "KRW",
            "USD",
            "EUR",
            "JPY",
            "GBP",
            "CNY",
            "TWD",
            "HKD",
            "SGD",
            "THB",
            "VND",
            "PHP",
            "IDR",
            "MYR",
            "AUD",
            "NZD",
            "CAD"
