{
  "name": "place-order",
  "directCallEnabled": true,
  "anonymousCallEnabled": false,
  "definition": {
    "method": "Post",
    "payloadSchema": {
      "type": "object",
      "required": [
        "tableNo",
        "orderType",
        "lines"
      ],
      "properties": {
        "tableNo": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        },
        "orderType": {
          "type": "string",
          "enum": [
            "here",
            "togo"
          ]
        },
        "note": {
          "type": "string",
          "maxLength": 200
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "itemId",
              "qty",
              "options"
            ],
            "properties": {
              "itemId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              "qty": {
                "type": "integer",
                "minimum": 1,
                "maximum": 50
              },
              "options": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "maxLength": 80
                }
              }
            }
          }
        }
      }
    },
    "statements": [
      {
        "type": "ResourceRead",
        "name": "store",
        "resource": "Content",
        "target": {
          "sys": {
            "id": "__STORE_ID__"
          }
        },
        "from": "Published"
      },
      {
        "type": "SetVar",
        "var": "clock",
        "value": {
          "dow": {
            "$%": [
              {
                "$+": [
                  {
                    "$/": [
                      {
                        "$-": [
                          {
                            "$+": [
                              "{ /now/millis }",
                              {
                                "$if": [
                                  {
                                    "$===": [
                                      "{ /store/fields/utcOffsetMin/en-US }",
                                      null
                                    ]
                                  },
                                  32400000,
                                  {
                                    "$*": [
                                      "{ /store/fields/utcOffsetMin/en-US }",
                                      60000
                                    ]
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "$%": [
                              {
                                "$+": [
                                  "{ /now/millis }",
                                  {
                                    "$if": [
                                      {
                                        "$===": [
                                          "{ /store/fields/utcOffsetMin/en-US }",
                                          null
                                        ]
                                      },
                                      32400000,
                                      {
                                        "$*": [
                                          "{ /store/fields/utcOffsetMin/en-US }",
                                          60000
                                        ]
                                      }
                                    ]
                                  }
                                ]
                              },
                              86400000
                            ]
                          }
                        ]
                      },
                      86400000
                    ]
                  },
                  4
                ]
              },
              7
            ]
          },
          "min": {
            "$/": [
              {
                "$-": [
                  {
                    "$%": [
                      {
                        "$+": [
                          "{ /now/millis }",
                          {
                            "$if": [
                              {
                                "$===": [
                                  "{ /store/fields/utcOffsetMin/en-US }",
                                  null
                                ]
                              },
                              32400000,
                              {
                                "$*": [
                                  "{ /store/fields/utcOffsetMin/en-US }",
                                  60000
                                ]
                              }
                            ]
                          }
                        ]
                      },
                      86400000
                    ]
                  },
                  {
                    "$%": [
                      {
                        "$+": [
                          "{ /now/millis }",
                          {
                            "$if": [
                              {
                                "$===": [
                                  "{ /store/fields/utcOffsetMin/en-US }",
                                  null
                                ]
                              },
                              32400000,
                              {
                                "$*": [
                                  "{ /store/fields/utcOffsetMin/en-US }",
                                  60000
                                ]
                              }
                            ]
                          }
                        ]
                      },
                      60000
                    ]
                  }
                ]
              },
              60000
            ]
          },
          "day": {
            "$date": [
              {
                "$+": [
                  "{ /now/millis }",
                  {
                    "$if": [
                      {
                        "$===": [
                          "{ /store/fields/utcOffsetMin/en-US }",
                          null
                        ]
                      },
                      32400000,
                      {
                        "$*": [
                          "{ /store/fields/utcOffsetMin/en-US }",
                          60000
                        ]
                      }
                    ]
                  }
                ]
              },
              "day"
            ]
          }
        }
      },
      {
        "type": "SetVar",
        "var": "today",
        "value": {
          "$if": [
            {
              "and": [
                {
                  "!!": [
                    "{ /store/fields/hours/en-US/0 }"
                  ]
                },
                {
                  "==": [
                    "{ /store/fields/hours/en-US/0/dow }",
                    "{ /vars/clock/dow }"
                  ]
                }
              ]
            },
            "{ /store/fields/hours/en-US/0 }",
            {
              "and": [
                {
                  "!!": [
                    "{ /store/fields/hours/en-US/1 }"
                  ]
                },
                {
                  "==": [
                    "{ /store/fields/hours/en-US/1/dow }",
                    "{ /vars/clock/dow }"
                  ]
                }
              ]
            },
            "{ /store/fields/hours/en-US/1 }",
            {
              "and": [
                {
                  "!!": [
                    "{ /store/fields/hours/en-US/2 }"
                  ]
                },
                {
                  "==": [
                    "{ /store/fields/hours/en-US/2/dow }",
                    "{ /vars/clock/dow }"
                  ]
                }
              ]
            },
            "{ /store/fields/hours/en-US/2 }",
            {
              "and": [
                {
                  "!!": [
                    "{ /store/fields/hours/en-US/3 }"
                  ]
                },
                {
                  "==": [
                    "{ /store/fields/hours/en-US/3/dow }",
                    "{ /vars/clock/dow }"
                  ]
                }
              ]
            },
            "{ /store/fields/hours/en-US/3 }",
            {
              "and": [
                {
                  "!!": [
                    "{ /store/fields/hours/en-US/4 }"
                  ]
                },
                {
                  "==": [
                    "{ /store/fields/hours/en-US/4/dow }",
                    "{ /vars/clock/dow }"
                  ]
                }
              ]
            },
            "{ /store/fields/hours/en-US/4 }",
            {
              "and": [
                {
                  "!!": [
                    "{ /store/fields/hours/en-US/5 }"
                  ]
                },
                {
                  "==": [
                    "{ /store/fields/hours/en-US/5/dow }",
                    "{ /vars/clock/dow }"
                  ]
                }
              ]
            },
            "{ /store/fields/hours/en-US/5 }",
            {
              "and": [
                {
                  "!!": [
                    "{ /store/fields/hours/en-US/6 }"
                  ]
                },
                {
                  "==": [
                    "{ /store/fields/hours/en-US/6/dow }",
                    "{ /vars/clock/dow }"
                  ]
                }
              ]
            },
            "{ /store/fields/hours/en-US/6 }",
            null
          ]
        }
      },
      {
        "type": "If",
        "condition": {
          "or": [
            {
              "or": [
                {
                  "!": [
                    "{ /store/fields/acceptOrders/en-US }"
                  ]
                },
                {
                  "!": [
                    "{ /vars/today }"
                  ]
                },
                {
                  "!": [
                    "{ /vars/today/open }"
                  ]
                },
                {
                  "!": [
                    {
                      "if": [
                        {
                          "<": [
                            "{ /vars/today/fromMin }",
                            "{ /vars/today/toMin }"
                          ]
                        },
                        {
                          "and": [
                            {
                              ">=": [
                                "{ /vars/clock/min }",
                                "{ /vars/today/fromMin }"
                              ]
                            },
                            {
                              "<": [
                                "{ /vars/clock/min }",
                                {
                                  "-": [
                                    "{ /vars/today/toMin }",
                                    "{ /store/fields/lastOrderMinutes/en-US }"
                                  ]
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "or": [
                            {
                              ">=": [
                                "{ /vars/clock/min }",
                                "{ /vars/today/fromMin }"
                              ]
                            },
                            {
                              "<": [
                                "{ /vars/clock/min }",
                                {
                                  "-": [
                                    "{ /vars/today/toMin }",
                                    "{ /store/fields/lastOrderMinutes/en-US }"
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "and": [
                {
                  "==": [
                    "{ /payload/orderType }",
                    "togo"
                  ]
                },
                {
                  "!": [
                    "{ /store/fields/allowTogo/en-US }"
                  ]
                }
              ]
            }
          ]
        },
        "then": [
          {
            "type": "Return",
            "value": {
              "ok": false,
              "error": {
                "$if": [
                  {
                    "or": [
                      {
                        "!": [
                          "{ /store/fields/acceptOrders/en-US }"
                        ]
                      },
                      {
                        "!": [
                          "{ /vars/today }"
                        ]
                      },
                      {
                        "!": [
                          "{ /vars/today/open }"
                        ]
                      },
                      {
                        "!": [
                          {
                            "if": [
                              {
                                "<": [
                                  "{ /vars/today/fromMin }",
                                  "{ /vars/today/toMin }"
                                ]
                              },
                              {
                                "and": [
                                  {
                                    ">=": [
                                      "{ /vars/clock/min }",
                                      "{ /vars/today/fromMin }"
                                    ]
                                  },
                                  {
                                    "<": [
                                      "{ /vars/clock/min }",
                                      {
                                        "-": [
                                          "{ /vars/today/toMin }",
                                          "{ /store/fields/lastOrderMinutes/en-US }"
                                        ]
                                      }
                                    ]
                                  }
                                ]
                              },
                              {
                                "or": [
                                  {
                                    ">=": [
                                      "{ /vars/clock/min }",
                                      "{ /vars/today/fromMin }"
                                    ]
                                  },
                                  {
                                    "<": [
                                      "{ /vars/clock/min }",
                                      {
                                        "-": [
                                          "{ /vars/today/toMin }",
                                          "{ /store/fields/lastOrderMinutes/en-US }"
                                        ]
                                      }
                                    ]
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  "closed",
                  "togo-disabled"
                ]
              }
            },
            "isError": true,
            "statusCode": 409
          }
        ]
      },
      {
        "type": "Loop",
        "name": "ln",
        "over": "{ /payload/lines }",
        "maxIterations": 20,
        "body": [
          {
            "type": "ResourceFind",
            "name": "mi",
            "resource": "Content",
            "contentType": {
              "sys": {
                "id": "__CT_ITEM__"
              }
            },
            "where": {
              "sys.id": {
                "eq": "{ /ln/itemId }"
              }
            },
            "from": "Published",
            "advanced": false
          },
          {
            "type": "If",
            "condition": {
              "or": [
                {
                  "==": [
                    "{ /mi }",
                    null
                  ]
                },
                {
                  "==": [
                    "{ /mi/fields/soldOut/en-US }",
                    true
                  ]
                }
              ]
            },
            "then": [
              {
                "type": "Return",
                "value": {
                  "ok": false,
                  "error": "unavailable",
                  "itemId": "{ /ln/itemId }",
                  "name": "{ /mi/fields/name/en-US }"
                },
                "isError": true,
                "statusCode": 409
              }
            ]
          },
          {
            "type": "SetVar",
            "var": "cur",
            "value": {
              "unit": "{ /mi/fields/price/en-US }",
              "text": "",
              "n": 0,
              "keys": [],
              "groups": {
                "$if": [
                  "{ /mi/fields/optionGroups/en-US }",
                  "{ /mi/fields/optionGroups/en-US }",
                  []
                ]
              }
            }
          },
          {
            "type": "Loop",
            "name": "g",
            "over": "{ /vars/cur/groups }",
            "maxIterations": 10,
            "body": [
              {
                "type": "SetVar",
                "var": "cur",
                "value": {
                  "unit": "{ /vars/cur/unit }",
                  "text": "{ /vars/cur/text }",
                  "n": 0,
                  "keys": "{ /vars/cur/keys }",
                  "groups": "{ /vars/cur/groups }"
                }
              },
              {
                "type": "Loop",
                "name": "op",
                "over": "{ /g/options }",
                "maxIterations": 20,
                "body": [
                  {
                    "type": "If",
                    "condition": {
                      "in": [
                        {
                          "cat": [
                            "{ /g/id }",
                            ":",
                            "{ /op/id }"
                          ]
                        },
                        "{ /ln/options }"
                      ]
                    },
                    "then": [
                      {
                        "type": "SetVar",
                        "var": "cur",
                        "value": {
                          "unit": {
                            "$+": [
                              "{ /vars/cur/unit }",
                              "{ /op/price }"
                            ]
                          },
                          "text": {
                            "$if": [
                              {
                                "$==": [
                                  "{ /vars/cur/text }",
                                  ""
                                ]
                              },
                              "{ /op/name/en-US }",
                              {
                                "$cat": [
                                  "{ /vars/cur/text }",
                                  " · ",
                                  "{ /op/name/en-US }"
                                ]
                              }
                            ]
                          },
                          "n": {
                            "$+": [
                              "{ /vars/cur/n }",
                              1
                            ]
                          },
                          "keys": {
                            "$merge": [
                              "{ /vars/cur/keys }",
                              {
                                "$cat": [
                                  "{ /g/id }",
                                  ":",
                                  "{ /op/id }"
                                ]
                              }
                            ]
                          },
                          "groups": "{ /vars/cur/groups }"
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "type": "If",
                "condition": {
                  "or": [
                    {
                      "and": [
                        "{ /g/required }",
                        {
                          "==": [
                            "{ /vars/cur/n }",
                            0
                          ]
                        }
                      ]
                    },
                    {
                      "and": [
                        {
                          "!": [
                            "{ /g/multi }"
                          ]
                        },
                        {
                          ">": [
                            "{ /vars/cur/n }",
                            1
                          ]
                        }
                      ]
                    }
                  ]
                },
                "then": [
                  {
                    "type": "Return",
                    "value": {
                      "ok": false,
                      "error": {
                        "$if": [
                          {
                            "$==": [
                              "{ /vars/cur/n }",
                              0
                            ]
                          },
                          "option-required",
                          "option-single"
                        ]
                      },
                      "itemId": "{ /mi/sys/id }",
                      "name": "{ /mi/fields/name/en-US }",
                      "groupId": "{ /g/id }",
                      "group": "{ /g/name/en-US }"
                    },
                    "isError": true,
                    "statusCode": 400
                  }
                ]
              }
            ]
          },
          {
            "type": "SetVar",
            "var": "line",
            "value": {
              "itemId": "{ /mi/sys/id }",
              "name": "{ /mi/fields/name/en-US }",
              "sectionId": "{ /mi/fields/section/en-US/sys/id }",
              "qty": "{ /ln/qty }",
              "basePrice": "{ /mi/fields/price/en-US }",
              "unitPrice": "{ /vars/cur/unit }",
              "options": "{ /vars/cur/text }",
              "optionKeys": "{ /vars/cur/keys }",
              "lineTotal": {
                "$*": [
                  "{ /vars/cur/unit }",
                  "{ /ln/qty }"
                ]
              }
            }
          },
          {
            "type": "SetVar",
            "var": "acc",
            "value": {
              "lines": {
                "$if": [
                  "{ /vars/acc/lines }",
                  {
                    "$merge": [
                      "{ /vars/acc/lines }",
                      "{ /vars/line }"
                    ]
                  },
                  [
                    "{ /vars/line }"
                  ]
                ]
              },
              "total": {
                "$+": [
                  "{ /vars/acc/total }",
                  "{ /vars/line/lineTotal }"
                ]
              },
              "opt": {
                "$+": [
                  "{ /vars/acc/opt }",
                  {
                    "$*": [
                      {
                        "$-": [
                          "{ /vars/cur/unit }",
                          "{ /mi/fields/price/en-US }"
                        ]
                      },
                      "{ /ln/qty }"
                    ]
                  }
                ]
              },
              "qty": {
                "$+": [
                  "{ /vars/acc/qty }",
                  "{ /ln/qty }"
                ]
              },
              "summary": {
                "$if": [
                  "{ /vars/acc/summary }",
                  {
                    "$cat": [
                      "{ /vars/acc/summary }",
                      ", ",
                      {
                        "$cat": [
                          "{ /vars/line/name }",
                          {
                            "$if": [
                              {
                                "$==": [
                                  "{ /vars/line/options }",
                                  ""
                                ]
                              },
                              "",
                              {
                                "$cat": [
                                  " (",
                                  "{ /vars/line/options }",
                                  ")"
                                ]
                              }
                            ]
                          },
                          " × ",
                          "{ /vars/line/qty }"
                        ]
                      }
                    ]
                  },
                  {
                    "$cat": [
                      "{ /vars/line/name }",
                      {
                        "$if": [
                          {
                            "$==": [
                              "{ /vars/line/options }",
                              ""
                            ]
                          },
                          "",
                          {
                            "$cat": [
                              " (",
                              "{ /vars/line/options }",
                              ")"
                            ]
                          }
                        ]
                      },
                      " × ",
                      "{ /vars/line/qty }"
                    ]
                  }
                ]
              }
            }
          }
        ]
      },
      {
        "type": "Loop",
        "name": "attempt",
        "while": {
          "and": [
            {
              "!": [
                "{ /store/fields/prepay/en-US }"
              ]
            },
            {
              "!": [
                "{ /vars/seq }"
              ]
            }
          ]
        },
        "maxIterations": 6,
        "body": [
          {
            "type": "Try",
            "body": [
              {
                "type": "ResourceRead",
                "name": "ctr",
                "resource": "Content",
                "target": {
                  "sys": {
                    "id": "__COUNTER_ID__"
                  }
                },
                "from": "Current"
              },
              {
                "type": "ResourcePatch",
                "resource": "Content",
                "target": {
                  "sys": {
                    "id": "__COUNTER_ID__"
                  }
                },
                "fields": {
                  "day": "{ /vars/clock/day }",
                  "seq": {
                    "$if": [
                      {
                        "$==": [
                          "{ /ctr/fields/day/en-US }",
                          "{ /vars/clock/day }"
                        ]
                      },
                      {
                        "$+": [
                          "{ /ctr/fields/seq/en-US }",
                          1
                        ]
                      },
                      1
                    ]
                  }
                },
                "locale": "en-US",
                "version": "{ /ctr/sys/version }",
                "publish": false
              },
              {
                "type": "SetVar",
                "var": "seq",
                "value": {
                  "$if": [
                    {
                      "$==": [
                        "{ /ctr/fields/day/en-US }",
                        "{ /vars/clock/day }"
                      ]
                    },
                    {
                      "$+": [
                        "{ /ctr/fields/seq/en-US }",
                        1
                      ]
                    },
                    1
                  ]
                }
              }
            ],
            "catch": [
              {
                "type": "If",
                "condition": false,
                "then": []
              }
            ]
          }
        ]
      },
      {
        "type": "If",
        "condition": {
          "and": [
            {
              "!": [
                "{ /store/fields/prepay/en-US }"
              ]
            },
            {
              "!": [
                "{ /vars/seq }"
              ]
            }
          ]
        },
        "then": [
          {
            "type": "Return",
            "value": {
              "ok": false,
              "error": "busy"
            },
            "isError": true,
            "statusCode": 503
          }
        ]
      },
      {
        "type": "ResourceCreate",
        "name": "order",
        "resource": "Content",
        "contentType": {
          "sys": {
            "id": "__CT_ORDER__"
          }
        },
        "fields": {
          "orderNo": {
            "$if": [
              "{ /store/fields/prepay/en-US }",
              "",
              {
                "$cat": [
                  "A-",
                  {
                    "if": [
                      {
                        "<": [
                          "{ /vars/seq }",
                          10
                        ]
                      },
                      "00",
                      {
                        "if": [
                          {
                            "<": [
                              "{ /vars/seq }",
                              100
                            ]
                          },
                          "0",
                          ""
                        ]
                      }
                    ]
                  },
                  "{ /vars/seq }"
                ]
              }
            ]
          },
          "tableNo": "{ /payload/tableNo }",
          "orderType": "{ /payload/orderType }",
          "status": {
            "$if": [
              "{ /store/fields/prepay/en-US }",
              "pending",
              "new"
            ]
          },
          "lines": "{ /vars/acc/lines }",
          "note": {
            "$if": [
              {
                "$and": [
                  "{ /store/fields/allowNote/en-US }",
                  "{ /payload/note }"
                ]
              },
              "{ /payload/note }",
              ""
            ]
          },
          "total": "{ /vars/acc/total }",
          "optionTotal": "{ /vars/acc/opt }",
          "itemCount": "{ /vars/acc/qty }",
          "businessDay": "{ /vars/clock/day }",
          "currency": "{ /store/fields/currency/en-US }",
          "payment": {
            "$if": [
              "{ /store/fields/prepay/en-US }",
              "pending",
              "none"
            ]
          }
        },
        "locale": "en-US",
        "publish": false,
        "propagateEvents": true
