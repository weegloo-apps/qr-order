{
  "name": "start-checkout",
  "directCallEnabled": true,
  "anonymousCallEnabled": false,
  "definition": {
    "method": "Post",
    "payloadSchema": {
      "type": "object",
      "required": [
        "orderId"
      ],
      "properties": {
        "orderId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "locale": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "ko",
            "ja",
            "zh",
            "fr",
            "de",
            "es",
            "it",
            "pt",
            "nl",
            "th",
            "vi",
            "id",
            "ms",
            "tr",
            "pl",
            "sv",
            "da",
            "fi",
            "nb",
            "cs"
          ]
        }
      }
    },
    "secrets": [
      {
        "key": "STRIPE_SECRET_KEY",
        "value": "",
        "description": "Stripe secret key (server-side only)"
      }
    ],
    "statements": [
      {
        "type": "Try",
        "body": [
          {
            "type": "Regex",
            "name": "siteOrigin",
            "mode": "Match",
            "pattern": "^(https://[A-Za-z0-9.-]+|http://(localhost|127\\.0\\.0\\.1))(:[0-9]{1,5})?$",
            "value": "{ /headers/origin }"
          },
          {
            "type": "If",
            "condition": {
              "!": [
                "{ /siteOrigin }"
              ]
            },
            "then": [
              {
                "type": "Return",
                "value": {
                  "ok": false,
                  "error": "bad-origin"
                },
                "isError": true,
                "statusCode": 400
              }
            ]
          }
        ],
        "catch": [
          {
            "type": "Return",
            "value": {
              "ok": false,
              "error": "bad-origin"
            },
            "isError": true,
            "statusCode": 400
          }
        ]
      },
      {
        "type": "ResourceRead",
        "name": "store",
        "resource": "Content",
        "target": {
          "sys": {
            "id": "__STORE_ID__"
          }
        },
        "from": "Published"
      },
      {
        "type": "Try",
        "body": [
          {
            "type": "ResourceRead",
            "name": "o",
            "resource": "Content",
            "target": {
              "sys": {
                "id": "{ /payload/orderId }"
              }
            },
            "from": "Current"
          }
        ],
        "catch": [
          {
            "type": "Return",
            "value": {
              "ok": false,
              "error": "payment-unavailable",
              "reason": "order-not-found"
            },
            "isError": true,
            "statusCode": 404
          }
        ]
      },
      {
        "type": "If",
        "condition": {
          "or": [
            {
              "!=": [
                "{ /o/sys/contentType/sys/id }",
                "__CT_ORDER__"
              ]
            },
            {
              "!=": [
                "{ /o/fields/status/en-US }",
                "pending"
              ]
            },
            {
              "!=": [
                "{ /o/fields/payment/en-US }",
                "pending"
              ]
            },
            {
              "!!": [
                "{ /o/fields/stripeSessionId/en-US }"
              ]
            },
            {
              ">": [
                {
                  "-": [
                    "{ /now/millis }",
                    {
                      "date": [
                        "{ /o/sys/createdAt }"
                      ]
                    }
                  ]
                },
                1800000
              ]
            }
          ]
        },
        "then": [
          {
            "type": "Return",
            "value": {
              "ok": false,
              "error": "payment-unavailable",
              "reason": "order-not-payable"
            },
            "isError": true,
            "statusCode": 409
          }
        ]
      },
      {
        "type": "Try",
        "body": [
          {
            "type": "ResourcePatch",
            "resource": "Content",
            "target": {
              "sys": {
                "id": "{ /o/sys/id }"
              }
            },
            "fields": {
              "stripeSessionId": "starting"
            },
            "locale": "en-US",
            "version": "{ /o/sys/version }",
            "publish": false
          }
        ],
        "catch": [
          {
            "type": "Return",
            "value": {
              "ok": false,
              "error": "payment-unavailable",
              "reason": "busy"
            },
            "isError": true,
            "statusCode": 409
          }
        ]
      },
      {
        "type": "Loop",
        "name": "ln",
        "over": "{ /o/fields/lines/en-US }",
        "maxIterations": 20,
        "body": [
          {
            "type": "SetVar",
            "var": "sum",
            "value": {
              "$if": [
                "{ /vars/sum }",
                {
                  "$cat": [
                    "{ /vars/sum }",
                    ", ",
                    {
                      "$cat": [
                        "{ /ln/name }",
                        {
                          "$if": [
                            "{ /ln/options }",
                            {
                              "$cat": [
                                " (",
                                "{ /ln/options }",
                                ")"
                              ]
                            },
                            ""
                          ]
                        },
                        " × ",
                        "{ /ln/qty }"
                      ]
                    }
                  ]
                },
                {
                  "$cat": [
                    "{ /ln/name }",
                    {
                      "$if": [
                        "{ /ln/options }",
                        {
                          "$cat": [
                            " (",
                            "{ /ln/options }",
                            ")"
                          ]
                        },
                        ""
                      ]
                    },
                    " × ",
                    "{ /ln/qty }"
                  ]
                }
              ]
            }
          }
        ]
      },
      {
        "type": "Try",
        "body": [
          {
            "type": "Http",
            "name": "chk",
            "method": "POST",
            "url": "https://api.stripe.com/v1/checkout/sessions",
            "headers": [
              {
                "key": "Authorization",
                "value": "Bearer { /secrets/STRIPE_SECRET_KEY }"
              },
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "payment",
              "client_reference_id": "{ /o/sys/id }",
              "success_url": "{ /headers/origin }/paid/{ /o/sys/id }",
              "cancel_url": "{ /headers/origin }/cart?pay=cancel&order={ /o/sys/id }",
              "locale": {
                "$if": [
                  "{ /payload/locale }",
                  "{ /payload/locale }",
                  "auto"
                ]
              },
              "expires_at": {
                "$+": [
                  "{ /now/seconds }",
                  3600
                ]
              },
              "allowed_payment_method_types": [
                "card"
              ],
              "metadata": {
                "orderId": "{ /o/sys/id }",
                "tableNo": "{ /o/fields/tableNo/en-US }"
              },
              "line_items": [
                {
                  "quantity": 1,
                  "price_data": {
                    "currency": "{ /o/fields/currency/en-US }",
                    "unit_amount": "{ /o/fields/total/en-US }",
                    "product_data": {
                      "name": {
                        "$cat": [
                          "{ /store/fields/name/en-US }",
                          " · ",
                          {
                            "$if": [
                              {
                                "$==": [
                                  "{ /o/fields/tableNo/en-US }",
                                  0
                                ]
                              },
                              "Takeout",
                              {
                                "$cat": [
                                  "Table ",
                                  "{ /o/fields/tableNo/en-US }"
                                ]
                              }
                            ]
                          }
                        ]
                      },
                      "description": "{ /vars/sum }"
                    }
                  }
                }
              ]
            },
            "timeoutMs": 15000,
            "retry": 0,
            "ignoreStatusCode": true,
            "responseType": "Json"
          }
        ],
        "catch": [
          {
            "type": "Return",
            "value": {
              "ok": false,
              "error": "payment-unavailable"
            },
            "isError": true,
            "statusCode": 502
          }
        ]
      },
      {
        "type": "If",
        "condition": {
          ">=": [
            "{ /chk/status }",
            400
          ]
        },
        "then": [
          {
            "type": "Return",
            "value": {
              "ok": false,
              "error": "payment-unavailable",
              "reason": "{ /chk/body/error/code }",
              "param": "{ /chk/body/error/param }"
            },
            "isError": true,
            "statusCode": 502
          }
        ]
      },
      {
        "type": "ResourcePatch",
        "resource": "Content",
        "target": {
          "sys": {
            "id": "{ /o/sys/id }"
          }
        },
        "fields": {
          "stripeSessionId": "{ /chk/body/id }"
        },
        "locale": "en-US",
        "publish": false,
        "propagateEvents": true
      },
      {
        "type": "Return",
        "value": {
          "ok": true,
          "pay": {
            "orderId": "{ /o/sys/id }",
            "url": "{ /chk/body/url }"
          }
        },
        "isError": false,
        "statusCode": 200
      }
    ]
  }
}
